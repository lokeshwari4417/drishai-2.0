// DrishAI database schema
// Dev default: SQLite (zero setup). Swap provider to "postgresql" and set
// DATABASE_URL to a Supabase/Postgres connection string for production.
//
// NOTE ON ROLE/DRSTAGE/EYESIDE FIELDS: these are plain Strings, not Prisma
// enums. SQLite doesn't support native enum types at all, so Prisma refuses
// to validate a schema that declares `enum` blocks against a sqlite
// datasource. The set of valid values is enforced at the application layer
// instead (see the zod schemas in the API routes and the TS union types in
// lib/auth.ts and lib/dr-stages.ts). If you switch to Postgres/MySQL later,
// you can optionally convert these back to real `enum` types.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phoneNumber   String?
  passwordHash  String
  // One of: PATIENT | DOCTOR | NGO | ADMIN — validated by zod at the API layer.
  role          String    @default("PATIENT")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // A user with role PATIENT is linked to exactly one Patient record.
  patientProfile   Patient?  @relation("UserPatientProfile")

  // Doctors/NGO/Admin staff can be the creator of many patient records.
  createdPatients  Patient[] @relation("PatientCreatedBy")

  // Screenings an NGO/org has routed to this doctor for review.
  receivedScreenings ScreeningRecord[] @relation("ScreeningSentToDoctor")

  resetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Patient {
  id                String   @id @default(cuid())
  name              String
  age               Int
  gender            String
  diabetesDuration  Int?     // years
  contactNumber     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Optional link if the patient also has their own login (role PATIENT)
  userId            String?  @unique
  user              User?    @relation("UserPatientProfile", fields: [userId], references: [id])

  // Doctor / NGO / Admin who created & manages this patient record
  createdById       String
  createdBy         User     @relation("PatientCreatedBy", fields: [createdById], references: [id])

  screenings        ScreeningRecord[]

  @@map("patients")
}

model ScreeningRecord {
  id               String     @id @default(cuid())
  screeningDate    DateTime   @default(now())
  // One of: NO_DR | MILD | MODERATE | SEVERE | PROLIFERATIVE
  drStage          String?
  confidenceScore  Float?
  recommendation   String?
  createdAt        DateTime   @default(now())

  patientId        String
  patient          Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Set when an NGO/org routes this screening to a doctor for review.
  sentToDoctorId   String?
  sentToDoctor     User?      @relation("ScreeningSentToDoctor", fields: [sentToDoctorId], references: [id])
  sentAt           DateTime?

  images           RetinalImage[]
  analysis         AiAnalysis?

  @@map("screening_records")
}

model RetinalImage {
  id           String   @id @default(cuid())
  imagePath    String
  // One of: LEFT | RIGHT
  eyeSide      String
  capturedAt   DateTime @default(now())

  screeningId  String
  screening    ScreeningRecord @relation(fields: [screeningId], references: [id], onDelete: Cascade)

  @@map("retinal_images")
}

model AiAnalysis {
  id            String   @id @default(cuid())
  modelVersion  String
  heatmapPath   String?
  analyzedAt    DateTime @default(now())

  screeningId   String   @unique
  screening     ScreeningRecord @relation(fields: [screeningId], references: [id], onDelete: Cascade)

  @@map("ai_analyses")
}
