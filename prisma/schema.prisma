// DrishAI database schema
// Swapped provider to "mysql" for production MySQL database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id    String @id @default(cuid())
  name  String @unique // "PATIENT", "DOCTOR", "NGO", "ADMIN"
  users User[]

  @@map("roles")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phoneNumber  String?
  passwordHash String
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // Profile relations
  patientProfile Patient? @relation("UserPatientProfile")
  adminProfile   Admin?   @relation("UserAdminProfile")

  // Doctors/NGO/Admin staff can be the creator of many patient records.
  createdPatients Patient[] @relation("PatientCreatedBy")

  // Screenings an NGO/org has routed to this doctor for review.
  receivedScreenings ScreeningRecord[] @relation("ScreeningSentToDoctor")

  resetTokens    PasswordResetToken[]
  loginHistories LoginHistory[]
  activityLogs   ActivityLog[]
  otps           Otp[]

  @@map("users")
}

model Admin {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation("UserAdminProfile", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Otp {
  id        String   @id @default(cuid())
  code      String
  expiresAt DateTime
  resendAt  DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otps")
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  status    String   // "SUCCESS" or "FAILED"
  loggedAt  DateTime @default(now())

  @@map("login_histories")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // e.g. "LOGIN", "OTP_VERIFIED", "BLOCK_USER", "UNBLOCK_USER", etc.
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@map("activity_logs")
}

model Patient {
  id               String   @id @default(cuid())
  name             String
  age              Int
  gender           String
  diabetesDuration Int? // years
  contactNumber    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Optional link if the patient also has their own login (role PATIENT)
  userId String? @unique
  user   User?   @relation("UserPatientProfile", fields: [userId], references: [id])

  // Doctor / NGO / Admin who created & manages this patient record
  createdById String
  createdBy   User   @relation("PatientCreatedBy", fields: [createdById], references: [id])

  screenings ScreeningRecord[]

  @@map("patients")
}

model ScreeningRecord {
  id              String    @id @default(cuid())
  screeningDate   DateTime  @default(now())
  drStage         String?
  confidenceScore Float?
  recommendation  String?   @db.Text
  createdAt       DateTime  @default(now())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Set when an NGO/org routes this screening to a doctor for review.
  sentToDoctorId String?
  sentToDoctor   User?     @relation("ScreeningSentToDoctor", fields: [sentToDoctorId], references: [id])
  sentAt         DateTime?

  images   RetinalImage[]
  analysis AiAnalysis?

  @@map("screening_records")
}

model RetinalImage {
  id        String   @id @default(cuid())
  imagePath String   @db.Text
  eyeSide   String
  capturedAt DateTime @default(now())

  screeningId String
  screening   ScreeningRecord @relation(fields: [screeningId], references: [id], onDelete: Cascade)

  @@map("retinal_images")
}

model AiAnalysis {
  id           String   @id @default(cuid())
  modelVersion String
  heatmapPath  String?  @db.Text
  analyzedAt   DateTime @default(now())

  screeningId String          @unique
  screening   ScreeningRecord @relation(fields: [screeningId], references: [id], onDelete: Cascade)

  @@map("ai_analyses")
}
