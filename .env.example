# Database connection string (MySQL)
# Example: mysql://user:password@host:port/database_name
DATABASE_URL="mysql://root:password@localhost:3306/drishai"

# NextAuth base options
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Credentials
# Retrieve these from Google Cloud Console (https://console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Secure SMTP Configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false" # set to "true" for port 465 (SSL)
SMTP_USER="smtp-username"
SMTP_PASSWORD="smtp-password"
SMTP_FROM="DrishAI Support <noreply@drishai.dev>"

# Optional chatbot APIs
ANTHROPIC_API_KEY=""
