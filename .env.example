# SQLite for local dev (zero setup). For production, point this at your
# Supabase/Postgres connection string and change the provider in
# prisma/schema.prisma from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional: powers the real Claude-backed chatbot. Get one at
# https://console.anthropic.com/settings/keys — without it, the chatbot
# falls back to a small built-in rule-based responder automatically.
ANTHROPIC_API_KEY=""

# Optional: powers the "forgot password" email. Get a free key at
# https://resend.com/api-keys — without it, reset links are logged to
# your terminal instead of emailed, so you can still test the flow locally.
RESEND_API_KEY=""
# Must be a verified sender on your Resend account for production use.
# The default (onboarding@resend.dev) only works for sending to the email
# address you signed up to Resend with — fine for testing, not for real users.
RESEND_FROM_EMAIL="DrishAI <onboarding@resend.dev>"
